# === YatraSewa Environment Variables ===

# Database
DATABASE_URL="postgresql://yatrasewa:yatrasewa@localhost:5432/yatrasewa?schema=public"
DIRECT_URL="postgresql://yatrasewa:yatrasewa@localhost:5432/yatrasewa?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="replace-with-32-byte-hex-access-secret"
JWT_REFRESH_SECRET="replace-with-32-byte-hex-refresh-secret"
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# Server
API_PORT=4000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5173"

# SMS - Sparrow SMS v2
SPARROW_SMS_TOKEN="your-sparrow-token"
SPARROW_SMS_FROM="YatraSewa"
SPARROW_SMS_API_URL="https://api.sparrowmessages.com/v2/sms"
SPARROW_FAILOVER_TOKEN=""

# SMTP Email
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="notifications@yatrasewa.com.np"
SMTP_PASS="your-smtp-password"
EMAIL_FROM="YatraSewa <no-reply@yatrasewa.com.np>"

# eSewa ePay v2
ESEWA_PRODUCT_CODE="EPAYTEST"
ESEWA_SECRET_KEY="your-esewa-secret"
ESEWA_BASE_URL="https://rc-epay.esewa.com.np"
ESEWA_STATUS_URL="https://rc.esewa.com.np/api/epay/transaction/status/"
ESEWA_SUCCESS_URL="http://localhost:5173/payment/esewa/success"
ESEWA_FAILURE_URL="http://localhost:5173/payment/esewa/failure"

# Khalti KPG-2
KHALTI_SECRET_KEY="your-khalti-secret"
KHALTI_RETURN_URL="http://localhost:5173/payment/khalti/callback"
KHALTI_BASE_URL="https://a.khalti.com/api/v2"
KHALTI_WEBSITE_URL="http://localhost:5173"

# ConnectIPS / NCHL NPI
CONNECTIPS_MERCHANT_ID="your-merchant-id"
CONNECTIPS_APP_ID="your-app-id"
CONNECTIPS_APP_NAME="YatraSewa"
CONNECTIPS_PFX_PATH="./certs/connectips.pfx"
CONNECTIPS_PFX_PASSWORD="your-pfx-password"
CONNECTIPS_BASE_URL="https://connectips.com.np"
CONNECTIPS_VALIDATE_URL="https://connectips.com.np/connectipswebws/api/creditor/validatetxn"
CONNECTIPS_SUCCESS_URL="http://localhost:5173/payment/connectips/success"
CONNECTIPS_FAILURE_URL="http://localhost:5173/payment/connectips/failure"

# Fonepay Dynamic QR
FONEPAY_MERCHANT_CODE="your-fonepay-merchant"
FONEPAY_SECRET_KEY="your-fonepay-secret"
FONEPAY_BASE_URL="https://fonepay.com/api/v1"
FONEPAY_WEBHOOK_SECRET="your-webhook-secret"

# PDF / QR signing
TICKET_QR_HMAC_SECRET="replace-with-32-byte-hmac-secret"
