{
  "name": "yatrasewa",
  "version": "0.1.0",
  "private": true,
  "description": "YatraSewa — Nepal Bus Ticket Booking, Live GPS Fleet Telemetry & Automated Commission Settlement",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:migrate": "pnpm --filter @yatrasewa/database prisma migrate dev",
    "db:seed": "pnpm --filter @yatrasewa/database prisma db seed",
    "db:generate": "pnpm --filter @yatrasewa/database prisma generate"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9"
}
