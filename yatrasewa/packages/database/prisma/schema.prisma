// YatraSewa — PostgreSQL 18 + PostGIS 3.6 schema
// Enables postgis extension via migration; geography types are Unsupported until
// we add a PostGIS Prisma generator. We use Unsupported("geography(Point,4326)")
// for GIS columns and query them via $queryRaw when ST_DWithin is needed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 1. IDENTITY & RBAC
// ============================================================

enum Role {
  SUPER_ADMIN
  SYSTEM_EMPLOYEE
  OPERATOR_OWNER
  OPERATOR_STAFF
  DRIVER
  CONDUCTOR
  BOOKIE_COUNTER
  CUSTOMER
}

model User {
  id             String   @id @default(uuid())
  fullName       String
  phone          String?  @unique
  email          String?  @unique
  passwordHash   String?
  role           Role
  operatorId     String?  // OP-NP-XXXX
  counterId      String?  @unique
  totpSecret     String?
  is2faEnabled   Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  operator        Operator?        @relation("OperatorStaff", fields: [operatorId], references: [id], onDelete: SetNull)
  bookieCounter   BookieCounter?   @relation(fields: [counterId], references: [id], onDelete: SetNull)
  sessions        UserSession[]
  auditLogs       SecurityAuditLog[] @relation("AuditActor")
  bookings        Booking[]        @relation("BookingUser")
  checkedInPassengers BookingPassenger[] @relation("CheckedInBy")

  @@index([role])
  @@index([operatorId])
}

model UserSession {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String   @unique
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model SecurityAuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  action       String
  resourceType String
  resourceId   String?
  meta         Json?
  ip           String?
  createdAt    DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}

// ============================================================
// 2. ROLES & PERMISSIONS (dynamic RBAC)
// ============================================================

model RoleDefinition {
  id           String   @id @default(uuid())
  name         String   @unique
  isSystemRole Boolean  @default(false)
  description  String?
  createdAt    DateTime @default(now())
  permissions  RolePermission[]
}

model RolePermission {
  id             String @id @default(uuid())
  roleId         String
  permissionCode String // e.g., "seats:lock:counter"

  role RoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionCode])
}

// ============================================================
// 3. TENANTS & NETWORK
// ============================================================

enum OperatorStatus {
  pending
  approved
  suspended
  under_audit
}

model Operator {
  id             String         @id // OP-NP-XXXX
  legalName      String
  brandName      String
  panNo          String         @unique
  panVerified    Boolean        @default(false)
  status         OperatorStatus @default(pending)
  contactEmail   String
  contactPhone   String
  primaryAddress String
  logoUrl        String?
  commissionRate Decimal        @db.Decimal(5, 4) // e.g., 0.10 = 10%
  createdAt      DateTime       @default(now())
  approvedAt     DateTime?
  suspendedAt    DateTime?

  staff          User[]               @relation("OperatorStaff")
  kycDocuments   OperatorKycDocument[]
  buses          Bus[]
  routes         Route[]
  trips          Trip[]
  settlements    SettlementPayout[]
  bookieCounters BookieCounter[]
  ledgerAccounts LedgerAccount[]
  cabinLayouts   CabinLayout[]

  @@index([status])
}

enum KycDocType {
  dotm_operating_license
  company_registration
  pan_vat_registration
  fleet_insurance_policy
  pan_document
}

enum KycStatus {
  pending
  uploaded
  verified
  rejected
}

model OperatorKycDocument {
  id         String     @id @default(uuid())
  operatorId String
  docType    KycDocType
  fileUrl    String
  status     KycStatus  @default(pending)
  notes      String?
  uploadedAt DateTime   @default(now())
  verifiedAt DateTime?

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId, docType])
}

model BookieCounter {
  id           String  @id @default(uuid())
  counterCode  String  @unique
  operatorId   String
  ownerName    String
  address      String
  locationLat  Decimal? @db.Decimal(9, 6)
  locationLng  Decimal? @db.Decimal(9, 6)
  floatBalance Decimal @db.Decimal(14, 2) @default(0)
  floatLimit   Decimal @db.Decimal(14, 2) @default(50000)
  isActive     Boolean @default(true)
  createdAt    DateTime @default(now())

  operator     Operator   @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  user         User?
  bookings     Booking[]

  @@index([operatorId])
}

// ============================================================
// 4. FLEET & CABIN LAYOUTS
// ============================================================

enum VehicleType {
  deluxe
  ac_deluxe
  vip_sofa_2x1
  sleeper
  tourist
}

enum BusStatus {
  active
  maintenance
  retired
  documents_expired
}

model CabinLayout {
  id          String   @id @default(uuid())
  operatorId  String?
  name        String
  layoutJson  Json     // seats, aisleCols, deckCount
  deckCount   Int      @default(1)
  totalSeats  Int
  createdAt   DateTime @default(now())

  operator    Operator? @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  buses       Bus[]

  @@index([operatorId])
}

model Bus {
  id                 String      @id @default(uuid())
  operatorId         String
  plateNumber        String      @unique
  nickname           String?
  cabinLayoutId      String
  vehicleType        VehicleType
  amenities          Json        // wifi, charging, ac, water, blanket, ...
  telematicsEnabled  Boolean     @default(false)
  registrationDocUrl String?
  insuranceDocUrl    String?
  fitnessCertUrl     String?
  status             BusStatus   @default(active)
  createdAt          DateTime    @default(now())

  operator           Operator    @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  cabinLayout        CabinLayout @relation(fields: [cabinLayoutId], references: [id])
  trips              Trip[]
  telemetry          TripGpsTelemetry[]
}

// ============================================================
// 5. CITIES, ROUTES, STOPS
// ============================================================

model City {
  id          String   @id @default(uuid())
  name        String
  nameNe      String
  district    String
  province    String
  lat         Decimal  @db.Decimal(9, 6)
  lng         Decimal  @db.Decimal(9, 6)
  isPickupHub Boolean  @default(true)
  createdAt   DateTime @default(now())

  routesFrom  Route[] @relation("RouteOrigin")
  routesTo    Route[] @relation("RouteDestination")
  stops       RouteStop[]

  @@unique([name])
}

model Route {
  id            String   @id @default(uuid())
  operatorId    String?
  originCityId  String
  destCityId    String
  routeName     String
  corridorName  String
  distanceKm    Decimal  @db.Decimal(6, 2)
  baseFare      Decimal  @db.Decimal(10, 2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  operator      Operator? @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  originCity    City     @relation("RouteOrigin", fields: [originCityId], references: [id])
  destCity      City     @relation("RouteDestination", fields: [destCityId], references: [id])
  stops         RouteStop[]
  trips         Trip[]
}

model RouteStop {
  id                String  @id @default(uuid())
  routeId           String
  sequence          Int
  stopName          String
  lat               Decimal @db.Decimal(9, 6)
  lng               Decimal @db.Decimal(9, 6)
  geofenceRadiusM   Int     @default(1500)
  isBoarding        Boolean @default(true)
  isDropping        Boolean @default(true)
  arrivalOffsetMin  Int     @default(0)
  createdAt         DateTime @default(now())
  cityId            String?
  city              City?   @relation(fields: [cityId], references: [id], onDelete: SetNull)
  route             Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([routeId, sequence])
}

// ============================================================
// 6. TRIPS & TRIP_SEATS
// ============================================================

enum TripStatus {
  scheduled
  boarding
  in_transit
  completed
  cancelled
}

model Trip {
  id            String     @id @default(uuid())
  operatorId    String
  busId         String
  routeId       String
  tripDate      DateTime   @db.Date
  departureTime DateTime
  arrivalTime   DateTime
  driverId      String?
  conductorId   String?
  status        TripStatus @default(scheduled)
  fare          Decimal    @db.Decimal(10, 2)
  availableSeats Int
  createdAt     DateTime   @default(now())

  operator      Operator    @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  bus           Bus         @relation(fields: [busId], references: [id])
  route         Route       @relation(fields: [routeId], references: [id])
  seats         TripSeat[]
  bookings      Booking[]
  telemetry     TripGpsTelemetry[]

  @@index([operatorId, tripDate])
  @@index([routeId, tripDate])
}

enum TripSeatStatus {
  available
  locked
  booked
  held_crew
}

model TripSeat {
  id               String        @id @default(uuid())
  tripId           String
  seatLabel        String
  status           TripSeatStatus @default(available)
  lockedBy         String?
  lockedUntil      DateTime?
  bookingId        String?
  fromSegment      Int           @default(0)
  toSegment        Int           @default(999)
  version          Int           @default(0)

  trip             Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  booking          Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@unique([tripId, seatLabel])
  @@index([tripId, status])
}

// ============================================================
// 7. BOOKINGS & PASSENGERS
// ============================================================

enum BookingChannel {
  online
  bookie
  conductor
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  REFUNDED
  EXPIRED
}

model Booking {
  id              String         @id @default(uuid())
  pnr             String         @unique
  userId          String?
  tripId          String
  counterId       String?
  channel         BookingChannel
  status          BookingStatus  @default(PENDING_PAYMENT)
  totalFare       Decimal        @db.Decimal(14, 2)
  discount        Decimal        @db.Decimal(14, 2) @default(0)
  taxAmount       Decimal        @db.Decimal(14, 2) @default(0)
  platformFee     Decimal        @db.Decimal(14, 2) @default(0)
  netPayable      Decimal        @db.Decimal(14, 2)
  passengerCount  Int
  seatLabels      String[]
  couponId        String?
  contactPhone    String
  contactEmail    String?
  createdAt       DateTime       @default(now())
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  cancellationReason String?

  user            User?          @relation("BookingUser", fields: [userId], references: [id], onDelete: SetNull)
  trip            Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  counter         BookieCounter? @relation(fields: [counterId], references: [id], onDelete: SetNull)
  coupon          Coupon?        @relation(fields: [couponId], references: [id], onDelete: SetNull)
  passengers      BookingPassenger[]
  payments        PaymentTransaction[]
  tripSeats       TripSeat[]

  @@index([userId])
  @@index([tripId])
  @@index([counterId])
  @@index([status])
}

enum PassengerGender {
  male
  female
  other
}

enum IdType {
  citizenship
  passport
  driving_license
  national_id
  none
}

model BookingPassenger {
  id             String   @id @default(uuid())
  bookingId      String
  fullName       String
  age            Int
  gender         PassengerGender
  seatLabel      String
  idType         IdType   @default(none)
  idNumber       String?
  checkedIn      Boolean  @default(false)
  checkedInAt    DateTime?
  checkedInById  String?

  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  checkedInBy    User?    @relation("CheckedInBy", fields: [checkedInById], references: [id], onDelete: SetNull)

  @@index([bookingId])
}

model Coupon {
  id             String   @id @default(uuid())
  code           String   @unique
  discountType   String   // percent/fixed
  discountValue  Decimal  @db.Decimal(14, 2)
  minFare        Decimal? @db.Decimal(14, 2)
  maxDiscount    Decimal? @db.Decimal(14, 2)
  startsAt       DateTime
  expiresAt      DateTime
  usageLimit     Int
  usedCount      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  bookings       Booking[]
}

// ============================================================
// 8. PAYMENTS
// ============================================================

enum Gateway {
  esewa
  khalti
  connectips
  fonepay
  bookie_float
  conductor_cash
}

enum PaymentStatus {
  PENDING
  INITIATED
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
  VERIFYING
}

model PaymentTransaction {
  id                    String        @id @default(uuid())
  bookingId             String
  gateway               Gateway
  amount                Decimal       @db.Decimal(14, 2)
  gatewayTransactionId  String?
  status                PaymentStatus @default(PENDING)
  requestPayload        Json?
  responsePayload       Json?
  verified              Boolean       @default(false)
  verifiedAt            DateTime?
  createdAt             DateTime      @default(now())

  booking               Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([gateway, gatewayTransactionId])
}

// ============================================================
// 9. LEDGER (DOUBLE-ENTRY)
// ============================================================

enum AccountType {
  Platform_Gateway_Escrow
  Bookie_Prepaid_Float_Wallet
  Operator_Payable_Account
  Platform_Commission_Rev
  Tax_TDS_Payable
  Passenger_Receivable
  Conductor_Cash_Undeposited
  Customer_Wallet
}

enum JournalEntryType {
  booking_payment
  cancellation_refund
  settlement_payout
  bookie_float_topup
  conductor_remittance
  tds_remittance
  commission_recognition
}

model LedgerAccount {
  id               String      @id @default(uuid())
  accountType      AccountType
  accountOwnerType String      // platform/operator/bookie/customer/conductor
  accountOwnerId   String?
  currentBalance   Decimal     @db.Decimal(14, 2) @default(0)
  currency         String      @default("NPR")
  createdAt        DateTime    @default(now())

  postings         LedgerPosting[]
  operator         Operator?   @relation(fields: [accountOwnerId], references: [id], onDelete: SetNull)

  @@index([accountType, accountOwnerId])
}

model LedgerJournalEntry {
  id            String           @id @default(uuid())
  description   String
  entryType     JournalEntryType
  referenceType String
  referenceId   String
  createdById   String?
  createdAt     DateTime         @default(now())

  postings      LedgerPosting[]

  @@index([referenceType, referenceId])
}

model LedgerPosting {
  id             String             @id @default(uuid())
  journalEntryId String
  accountId      String
  debitAmount    Decimal            @db.Decimal(14, 2) @default(0)
  creditAmount   Decimal            @db.Decimal(14, 2) @default(0)
  createdAt      DateTime           @default(now())

  journalEntry   LedgerJournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        LedgerAccount      @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
}

// ============================================================
// 10. SETTLEMENTS
// ============================================================

enum SettlementStatus {
  pending
  approved
  processing
  paid
  failed
}

model SettlementPayout {
  id               String           @id @default(uuid())
  operatorId       String
  periodStart      DateTime         @db.Date
  periodEnd        DateTime         @db.Date
  grossCollected   Decimal          @db.Decimal(14, 2)
  commissionDeducted Decimal        @db.Decimal(14, 2)
  tdsDeducted      Decimal          @db.Decimal(14, 2)
  netPayable       Decimal          @db.Decimal(14, 2)
  status           SettlementStatus @default(pending)
  nchlBatchId      String?
  paidAt           DateTime?
  createdAt        DateTime         @default(now())

  operator         Operator         @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId, status])
}

// ============================================================
// 11. GPS TELEMETRY
// ============================================================

model TripGpsTelemetry {
  id          String   @id @default(uuid())
  tripId      String
  busId       String
  recordedAt  DateTime
  lat         Decimal  @db.Decimal(9, 6)
  lng         Decimal  @db.Decimal(9, 6)
  speedKmh    Decimal  @db.Decimal(5, 2) @default(0)
  headingDeg  Decimal  @db.Decimal(5, 2) @default(0)
  accuracyM   Decimal  @db.Decimal(5, 2) @default(10)
  source      String   @default("driver_app") // driver_app / hardware_tracker

  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  bus         Bus      @relation(fields: [busId], references: [id], onDelete: Cascade)

  @@index([tripId, recordedAt])
  @@index([busId, recordedAt])
}
